<div class="mb-3">
  <label for="cpf" class="form-label">CPF do cliente</label>
  <input
    type="text"
    class="form-control"
    id="cpf"
    name="cpf"
    value="{{client.cpf}}"
  />
</div>

<div class="mb-3">
  <label for="nome_completo" class="form-label">Nome completo</label>

<div class="d-flex justify-content-between align-items-center mt-4">
  <h4>Listagem de clientes</h4>
  <h4>
    <a href="/clients/create"><i class="bi bi-plus-square"></i></a>
  </h4>
</div>
<table class="table table-hover">
  <thead>
    <tr>
      <th scope="col">CPF</th>
      <th scope="col">Nome completo</th>
      <th scope="col">Celular</th>
      <th scope="col">E-mail</th>
      <th scope="col">Data de nascimento</th>
    </tr>
  </thead>
  <tbody>
    {{#each clients}}
      <tr>
        <td>{{cpf}}</td>
        <td>{{nome_completo}}</td>
        <td>{{celular}}</td>
        <td>{{e_mail}}</td>
        <td>{{data_nascimento}}</td>
        <td class="text-end">
          <a href="/clients/update/{{id}}"><i class="bi bi-pencil"></i></a>
          <a href="/clients/read/{{id}}"><i class="bi bi-eye"></i></a>
          <a href="/clients/remove/{{id}}"><i class="bi bi-trash"></i></a>
        </td>
      </tr>
    {{/each}}
  </tbody>
</table>
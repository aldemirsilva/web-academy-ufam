<div class="d-flex justify-content-between align-items-center mt-4">
  <h4>{{client.nome_completo}}</h4>
  <h4><a href="/clients"><i class="bi bi-arrow-left-square"></i></a></h4>
</div>

<div class="card" style="width: 18rem;">
  <div class="card-body">
    <p class="card-text"><strong>CPF: </strong>{{client.cpf}}</p>

    <p class="card-text"><strong>Celular: </strong>{{client.celular}}</p>

    <p class="card-text"><strong>E-mail: </strong>{{client.e_mail}}</p>

    <p class="card-text"><strong>Data de nascimento:
      </strong>{{client.data_nascimento}}</p>

    <a href="/clients/update/{{client.cpf}}" class="card-link"><i
        class="bi bi-pencil"
      ></i></a>
  </div>
</div>